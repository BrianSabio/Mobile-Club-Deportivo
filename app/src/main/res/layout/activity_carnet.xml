<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="top|center_horizontal"
    android:background="@color/carnet_fondo">

    <LinearLayout
        android:id="@+id/layout_carnet_card"
        android:layout_width="350dp"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:padding="0dp"
        android:background="@drawable/bg_contenedor_borde"
        android:elevation="8dp"
        android:layout_marginTop="24dp">

        <!-- Header del Carnet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/carnet_header_bg"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_club_logo"
                android:contentDescription="@string/carnet_cd_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carnet_tv_nombre_club"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carnet_tv_titulo"
                    android:textColor="#E8F5E9"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cuerpo del Carnet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Columna Datos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Fix #10: tools:text en lugar de android:text para valores de preview -->
                <TextView
                    android:id="@+id/tv_carnet_nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Nombre Apellido"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/carnet_texto_primario"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_carnet_dni"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="DNI: 00.000.000"
                    android:textSize="13sp"
                    android:textColor="@color/carnet_texto_secundario" />

                <TextView
                    android:id="@+id/tv_carnet_tipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Tipo: SOCIO"
                    android:textSize="13sp"
                    android:textColor="@color/carnet_texto_secundario" />

                <TextView
                    android:id="@+id/tv_carnet_tel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Tel: 123456"
                    android:textSize="13sp"
                    android:textColor="@color/carnet_texto_secundario" />

                <TextView
                    android:id="@+id/tv_carnet_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Email: info@club.com"
                    android:textSize="12sp"
                    android:textColor="@color/carnet_texto_secundario"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Columna Status/Nro -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="end|bottom">

                <TextView
                    android:id="@+id/tv_carnet_nro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Socio N°: #000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/carnet_header_bg"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_carnet_emision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Emisión: 00/00/0000"
                    android:textSize="10sp"
                    android:textColor="@color/carnet_texto_opaco" />

                <TextView
                    android:id="@+id/tv_carnet_vencimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Vence: 00/00/0000"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="@color/carnet_vencimiento" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Fix #6b: Botón explícito para emitir y persistir el carnet en la base de datos -->
    <Button
        android:id="@+id/btn_carnet_emitir"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:text="@string/carnet_btn_emitir"
        android:textStyle="bold"
        android:elevation="4dp" />

    <!-- Fix #13: backgroundTint usa referencia @color en lugar de hex hardcodeado -->
    <Button
        android:id="@+id/btn_carnet_download"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/carnet_header_bg"
        android:text="@string/carnet_btn_descargar"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:elevation="4dp" />

</LinearLayout>